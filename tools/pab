#!/usr/bin/env bash
# pab — Unix/macOS convenience wrapper around the cross-platform Python entrypoint tools/pab.py.
# Both hosts' committed hook configs call `python tools/pab.py <sub>` directly (works on Windows,
# no bash needed). This wrapper just lets Unix users run `./tools/pab <sub>` and keeps one source
# of stub logic in pab.py. Always exits with pab.py's status (0 for the stub). See pab.py header.
DIR="$(cd "$(dirname "$0")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$DIR/pab.py" "$@"
else
  exec python "$DIR/pab.py" "$@"
fi

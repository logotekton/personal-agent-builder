{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python tools/pab.py compile-adapter" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python tools/pab.py capture --from prompt" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "python tools/pab.py capture --from tool" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*", "hooks": [ { "type": "command", "command": "python tools/pab.py boundary-check" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python tools/pab.py mine-and-review" } ] }
    ]
  }
}
